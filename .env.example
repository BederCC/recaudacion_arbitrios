# ========================================================
# ARCHIVO DE CONFIGURACIÓN DE ENTORNO - SART
# Copia este archivo como .env en el servidor / hosting
# ========================================================

APP_ENV=production
APP_DEBUG=false

# URL Base del proyecto (opcional, se detecta automáticamente si se deja vacío)
# Ejemplo: BASE_URL=https://arbitrios.beder.site/
BASE_URL=

# Conexión a la Base de Datos MySQL (cPanel / VPS / Hosting)
DB_HOST=localhost
DB_PORT=3306
DB_NAME=recaudacion_arbitrios
DB_USER=root
DB_PASS=
